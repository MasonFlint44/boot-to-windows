//
// Boot to Windows one-click mode. Installed to
// /usr/share/polkit-1/rules.d/50-com.masonflint.BootToWindows.rules.
//
// Admins (sudo/admin/wheel) logged in at the machine can run the helper
// without a password. They could pick the boot entry from the firmware menu
// anyway. Everyone else, including remote and inactive sessions, gets the
// action's default: an admin password prompt.
polkit.addRule(function (action, subject) {
    if (action.id !== 'com.masonflint.BootToWindows.set-next-boot')
        return polkit.Result.NOT_HANDLED;
    var admin = subject.isInGroup('sudo') || subject.isInGroup('admin') ||
        subject.isInGroup('wheel');
    if (subject.local && subject.active && admin)
        return polkit.Result.YES;
    return polkit.Result.NOT_HANDLED;
});
