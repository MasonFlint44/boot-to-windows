#!/usr/bin/gjs -m
// SPDX-License-Identifier: GPL-2.0-or-later
//
// Optional one-click helper for the Boot to Windows extension. Installed
// root-owned to /usr/local/libexec/boot-to-windows/ and run through pkexec:
//
//   boot-to-windows-helper windows   next boot goes to Windows, once
//   boot-to-windows-helper default   next boot goes to the normal default
//
// Prints the resulting state as reported by the firmware.

import Gio from 'gi://Gio';
import System from 'system';

import {EFIBOOTMGR_CANDIDATES} from './lib/constants.js';
import {readSnapshotSync} from './lib/firmware.js';
import {helperMain} from './lib/helperCore.js';
import {TRUST_ATTRIBUTES, infoFromGio, isTrustedInfo} from './lib/trust.js';

function trustedEfibootmgr() {
    for (const path of EFIBOOTMGR_CANDIDATES) {
        try {
            const info = Gio.File.new_for_path(path).query_info(
                TRUST_ATTRIBUTES, Gio.FileQueryInfoFlags.NOFOLLOW_SYMLINKS, null);
            if (isTrustedInfo(infoFromGio(Gio, info)))
                return path;
        } catch {
            // not at this path
        }
    }
    return null;
}

function run(argv) {
    const proc = Gio.Subprocess.new(argv,
        Gio.SubprocessFlags.STDOUT_SILENCE | Gio.SubprocessFlags.STDERR_PIPE);
    const [, , stderr] = proc.communicate_utf8(null, null);
    return {status: proc.get_exit_status(), stderr: stderr ?? ''};
}

const result = helperMain({
    args: ARGV,
    readSnapshot: () => readSnapshotSync(),
    run,
    efibootmgr: trustedEfibootmgr(),
});
if (result.out)
    print(result.out);
if (result.err)
    printerr(`boot-to-windows-helper: ${result.err}`);
System.exit(result.code);
